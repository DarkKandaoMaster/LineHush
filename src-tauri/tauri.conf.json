{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LineHush",
  "mainBinaryName": "LineHush",
  "version": "0.11.0",
  "identifier": "com.kandao.linehush",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' http://linehush-media.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kandao",
    "copyright": "Copyright © 2026 Kandao",
    "shortDescription": "本地优先的图文笔记编辑器",
    "longDescription": "LineHush 是 Windows 专用的本地优先笔记编辑器，正文只有纯文本和图片，每篇笔记连同原图保存为一个 .hush 文件。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["hush"],
        "name": "LineHush.Diary",
        "description": "LineHush 笔记",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
